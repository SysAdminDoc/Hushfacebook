# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
*.bak

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
*.apkm
*.apks
*.xapk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# NPM modules
node_modules/

# Python bytecode caches
__pycache__/
*.pyc

# Release provenance receipts, published on the release beside the .mpp they describe
release-receipt-*.json

# Facebook APK fixtures stay local: they are Meta's binaries and never go in the repo
fixtures/

# Local clones of the patch sources this bundle was assembled from (read, never committed)
sources/

# Local working notes
CLAUDE.md
CODEX_CHANGELOG.md
.claude/

# Research notes (regenerated by research passes)
RESEARCH.md
Roadmap_Blocked.md

# Keep working documents local; publish usage, release notes and the contributing guide.
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!docs/**/*.md
